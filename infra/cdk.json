{
  "app": "pnpm exec tsx bin/infra.ts",
  "context": {
    "environment": "staging",
    "bootstrapOnly": false,
    "awsRegion": "ap-northeast-1",
    "stagingMonthlyBudgetUsd": 25,
    "productionMonthlyBudgetUsd": 20,
    "runtimeArchitecture": "serverless",
    "serverlessStagingMode": "preview",
    "backupRetentionDays": 7,
    "apiCpu": 256,
    "apiMemoryMiB": 512,
    "workerCpu": 256,
    "workerMemoryMiB": 512,
    "rdsInstanceType": "t4g.micro",
    "rdsAllocatedStorageGiB": 20,
    "rdsMultiAz": false,
    "rdsDeletionProtection": true,
    "workerScheduleEnabled": false,
    "imageTag": "bootstrap-required"
  }
}
