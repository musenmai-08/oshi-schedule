{
  "name": "oshi-schedule",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && eslint scripts/aws",
    "pretypecheck": "prisma generate",
    "typecheck": "turbo typecheck",
    "test": "turbo test && node --test scripts/aws/*.test.mjs",
    "test:e2e": "playwright test",
    "validate:trivy-ignore": "node scripts/validate-trivy-ignore.mjs .trivyignore",
    "validate:yaml": "node scripts/validate-yaml.mjs",
    "aws:node": "bash scripts/aws/with-project-node.sh node --version",
    "aws:cdk": "bash scripts/aws/with-project-node.sh pnpm --filter @oshi-schedule/infra cdk",
    "smoke:staging": "bash scripts/smoke-staging.sh",
    "staging:status": "bash scripts/aws/with-project-node.sh node scripts/aws/staging-operations.mjs status",
    "staging:wake": "bash scripts/aws/with-project-node.sh node scripts/aws/staging-operations.mjs wake",
    "staging:sleep": "bash scripts/aws/with-project-node.sh node scripts/aws/staging-operations.mjs sleep",
    "staging:cdk:phase1": "bash scripts/aws/staging-rollout.sh phase1",
    "staging:cdk:phase2": "bash scripts/aws/staging-rollout.sh phase2",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "sync:scheduled": "pnpm --filter @oshi-schedule/worker sync:scheduled"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.61.1",
    "@prisma/client": "6.19.3",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "prettier": "3.9.5",
    "prisma": "6.19.3",
    "tsx": "4.23.1",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "yaml": "2.9.0"
  }
}
