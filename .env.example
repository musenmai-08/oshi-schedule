NODE_ENV=development
APP_MODE=fake
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=mysql://oshi:oshi_password@localhost:3306/oshi_schedule
ALLOWED_EMAILS=developer@example.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_SERVICE_ROLE_KEY=replace_me
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
YOUTUBE_API_KEY=replace_me
# key id + 32 random bytes encoded as base64. Multiple keys are comma separated; first encrypts.
TOKEN_ENCRYPTION_KEYS=v1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SYNC_INTERVAL_MINUTES=60
YOUTUBE_MIN_FETCH_INTERVAL_SECONDS=300
SYNC_LOOKAHEAD_DAYS=30
EXTERNAL_API_TIMEOUT_MS=10000
NEXT_PUBLIC_DEMO_MODE=true
